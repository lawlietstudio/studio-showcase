---
// Header band for inner pages: optional photograph behind, eyebrow, title and lead.
import Img from './Img.astro';

const { title, lead, eyebrow, image, center = false, plain = false, class: className = '' } = Astro.props;
---
<header class:list={['page-head', { center, plain }, className]}>
  {image && <Img class="ph-img" src={image} alt="" widths={[800, 1200, 1600, 1920]} eager />}
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>
