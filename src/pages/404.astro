---
import Layout from '../sites/studio/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { href } from '../lib/i18n';
---
<Layout lang="en" path="/404/" title="Page not found">
  <PageHead title="Page not found" lead="The page you were looking for does not exist." plain />
  <section class="section" style="text-align:center">
    <div class="container"><a class="btn btn-primary" href={href('', '/', 'en')}>Back to the portfolio<span class="arr" aria-hidden="true"></span></a></div>
  </section>
</Layout>
